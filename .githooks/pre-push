#!/usr/bin/env bash
# Chequeo rápido local antes de pushear a cualquier rama.
# No reemplaza al CI (que corre pytest completo) -- esto es la red de
# seguridad barata que hubiera atajado en segundos el incidente del
# 2026-09-10 (una funcion renderMercado() pegada dos veces en app.js dejo
# sin sintaxis valida TODO el archivo, y se pusheo/desplego sin que nadie
# lo notara hasta que el Tablero de produccion quedo en blanco).
set -e

NODE_CMD="node"
if ! command -v node >/dev/null 2>&1; then
  for p in "/mnt/c/Program Files/nodejs/node.exe" "/c/Program Files/nodejs/node.exe" "C:/Program Files/nodejs/node.exe"; do
    if [ -x "$p" ] || [ -f "$p" ]; then
      NODE_CMD="$p"
      break
    fi
  done
fi

echo "[pre-push] Validando sintaxis JS de la PWA..."
for f in src/pwa/static/*.js; do
  if ! "$NODE_CMD" --check "$f" 2>&1; then
    echo "[pre-push] ABORTADO: sintaxis invalida en $f"
    echo "[pre-push] Revisa el archivo antes de pushear. Para saltarte esto (no recomendado): git push --no-verify"
    exit 1
  fi
done

echo "[pre-push] Validando sintaxis Python..."
PYTHON_CMD="python"
if ! command -v python >/dev/null 2>&1; then
  for p in python3 py "/mnt/c/Users/Owner/AppData/Local/Programs/Python/Python313/python.exe" "/c/Users/Owner/AppData/Local/Programs/Python/Python313/python.exe"; do
    if command -v "$p" >/dev/null 2>&1 || [ -x "$p" ] || [ -f "$p" ]; then
      PYTHON_CMD="$p"
      break
    fi
  done
fi
if ! "$PYTHON_CMD" -m compileall -q src/; then
  echo "[pre-push] ABORTADO: sintaxis invalida en Python (ver arriba)."
  exit 1
fi

echo "[pre-push] Corriendo ruff (mismo lint que exige el CI)..."
if "$PYTHON_CMD" -m ruff --version >/dev/null 2>&1; then
  if ! "$PYTHON_CMD" -m ruff check .; then
    echo "[pre-push] ABORTADO: ruff encontro errores (el CI tambien fallara)."
    echo "[pre-push] Corrige con 'ruff check .' (y 'ruff check . --fix' cuando aplique)."
    echo "[pre-push] La causa mas comun de CI en rojo son imports sin usar (F401)."
    exit 1
  fi
else
  echo "[pre-push] AVISO: ruff no instalado; se omite el lint local (el CI si lo corre)."
  echo "[pre-push]   Instalalo con: pip install -r requirements-dev.txt"
fi

echo "[pre-push] Validando que no haya handlers inline en templates (CSP)..."
if ! "$PYTHON_CMD" scripts/verificar_csp_templates.py; then
  echo "[pre-push] ABORTADO: hay onclick/onX inline en src/pwa/templates/*.html."
  echo "[pre-push] La CSP de produccion (script-src 'self') los bloquea: el boton queda muerto."
  echo "[pre-push] Migra a addEventListener() en app.js (ver auditoria P0.3, 2026-09-23)."
  exit 1
fi

echo "[pre-push] Validando funciones JS duplicadas en el mismo ambito..."
if ! "$PYTHON_CMD" scripts/verificar_js_duplicados.py; then
  echo "[pre-push] ABORTADO: funcion(es) duplicada(s) en src/pwa/static/*.js."
  echo "[pre-push] node --check NO detecta redeclaraciones ES5 validas (incidente renderMercado 2026-09-10)."
  exit 1
fi

echo "[pre-push] OK -- sintaxis valida. (El CI en GitHub correra pytest completo)."
