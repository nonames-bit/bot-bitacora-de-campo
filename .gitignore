# .gitignore para Proyectos (Optimizado para Google Drive y Git)

# Entornos Virtuales y Dependencias Pesadas
.venv/
venv/
env/
node_modules/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# IDEs y Editores
.vscode/
.idea/
.kilo/
*.swp
*.swo
*~

# Graphify y Grafos Locales
graphify-out/
*.graphml

# Compilación y Salidas
build/
dist/
bin/
obj/
*.exe
*.dll
*.so
*.dylib

# Google Drive y Archivos Temporales de Sistema
.tmp.driveupload/
*.tmp.driveupload
Thumbs.db
Desktop.ini
.DS_Store

# Logs y Archivos de Depuración
*.log
npm-debug.log*
yarn-debug.log*

# Datos locales, multimedia y backups
data/
media/
backups/
*cookies.txt
screenshots_mobile/
scratch/
src/server/users.json

# Archivos de Secretos y Configuración Local
.env
.env.local
*.local

# Claves de cuentas de servicio (Google Earth Engine, etc.)
secrets/
*serviceaccount*.json
*service-account*.json
*earthengine*.json
*earth-engine*.json

# Backup real de Software Ganadero (datos de produccion, fuera del control de versiones)
docs/*.Zip

# Capturas de referencia masivas (no son necesarias para el código ni la doc)
docs/fotos del software Ganadero SG/fotos app ganadero/

# Herramientas locales de agentes
.opencode/

# (auditoría P2.13, 2026-09-23) Binarios de evidencia y artefactos generados que
# se des-trackearon: engordaban el repo (~21 MB) y no son código ni doc enlazada.
# Evidencia visual generada por scripts/verify_*.py:
docs/screenshots/
docs/screenshots_features/
docs/screenshots_sg/
# Capturas masivas de referencia de Software Ganadero:
docs/fotos del software Ganadero SG/
# Videos fuente de los GIF del header (el asset servido es el GIF):
src/pwa/static/toro.mp4
src/pwa/static/ternero.mp4
# Reportes generados por scripts (comparación SG):
reportes/
# Manuales de referencia pesados:
docs/Manuales Informacion/Manual29SoftwareGanadero.pdf
