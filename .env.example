# Antes del primer arranque, copiar users.example.json → src/server/users.json y editar el user_id del OWNER (bootstrap)
TELEGRAM_TOKEN=pegar_aqui_el_token_del_botfather
BITACORA_DB=data/bitacora.db
USERS_FILE=src/server/users.json
MEDIA_DIR=media
LOG_FILE=bot.log

# Sincronización automática de copias Software Ganadero (SG)
COPIAS_DIR=/root/bitacora/data/copias
COPIAS_AUTOIMPORT=true

# Integración LLM en la nube — cascada de proveedores, del más barato/gratuito
# al de pago (ver src/llm/__init__.py:try_hybrid_parse). Cada uno se salta
# automáticamente si su *_API_KEY queda vacía o con el placeholder.
# Orden real: OpenRouter -> CheaperInference -> OpenCode Go -> NVIDIA -> Gemini.

# 1. OpenRouter (openrouter.ai) — agrega Gemini/Claude/Llama/DeepSeek, con
#    modelos gratuitos (ids terminados en ":free"). Copiar el id EXACTO del
#    modelo elegido desde el dashboard (openrouter.ai/models).
OPENROUTER_API_KEY=pegar_aqui_tu_clave_de_openrouter
OPENROUTER_MODEL=pegar_aqui_el_id_del_modelo
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# 2. CheaperInference (platform.cheaperinference.com) — modelo elegido:
#    deepseek-v4-flash ($0.04/M entrada, $0.09/M salida — el más barato
#    confirmado en el catálogo, de sobra para extraer JSON de notas cortas).
CHEAPERINFERENCE_API_KEY=pegar_aqui_tu_clave_de_cheaperinference
CHEAPERINFERENCE_MODEL=deepseek-v4-flash
CHEAPERINFERENCE_BASE_URL=https://api.cheaperinference.com/v1/chat/completions

# 3. OpenCode Go — NO usado como proveedor de este bot a propósito (es la
#    fuente de un cobro inesperado por consumo de tokens en otra herramienta
#    del usuario; evitamos sumarle más tráfico aquí).

# 4. NVIDIA NIM (build.nvidia.com) — gratuito
NVIDIA_API_KEY=pegar_aqui_tu_clave_de_nvidia
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

# 5. Gemini (Google AI Studio) — más preciso con JSON estructurado, pero de
#    pago. Se usa solo como ÚLTIMO recurso si nada más resolvió la nota.
#    Dejar vacío para desactivarlo por completo y no generar ningún costo.
GEMINI_API_KEY=pegar_aqui_tu_clave_de_gemini
GEMINI_MODEL=gemini-2.5-flash

# Google Earth Engine — NDVI satelital real de potreros (Fase C del plan
# geoespacial, ver docs/PLAN_GEO_SATELITAL_6.2_8.2.md). Se usa solo desde
# scripts/actualizar_ndvi_satelital.py (job semanal), no en el bot en vivo.
# NUNCA subir el archivo .json de la cuenta de servicio al repositorio.
GEE_SERVICE_ACCOUNT_EMAIL=pegar_aqui_el_email_de_la_cuenta_de_servicio@tu-project-id.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=C:\ruta\fuera\del\repo\a\tu-clave.json
GEE_PROJECT_ID=pegar_aqui_tu_project_id

