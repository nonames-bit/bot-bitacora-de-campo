# Antes del primer arranque, copiar users.example.json → src/server/users.json y editar el user_id del OWNER (bootstrap)
TELEGRAM_TOKEN=pegar_aqui_el_token_del_botfather
BITACORA_DB=data/bitacora.db
USERS_FILE=src/server/users.json
MEDIA_DIR=media
LOG_FILE=bot.log

# Integración LLM en la nube — soporta ambos proveedores (usa el que tenga key)
# Gemini (Google AI Studio) — recomendado, más preciso con JSON
GEMINI_API_KEY=pegar_aqui_tu_clave_de_gemini
GEMINI_MODEL=gemini-2.5-flash
# NVIDIA NIM (build.nvidia.com) — gratuito, fallback automático si Gemini no está
NVIDIA_API_KEY=pegar_aqui_tu_clave_de_nvidia
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

